root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,rs,sh}]
indent_size = 4

[*.{kt,kts}]
max_line_length = 100
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-wildcard-imports = enabled

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
