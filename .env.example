# Copy to .env and fill in. Never commit .env. Variables are described in docs/development.md section 5.
# Provider smoke tests and GitHub tests arrive in P1 and P4; the signing variables are used by release builds.

TETHER_TEST_ANTHROPIC_KEY=
TETHER_TEST_OPENAI_KEY=
TETHER_TEST_GEMINI_KEY=
TETHER_TEST_DEEPSEEK_KEY=
TETHER_TEST_OPENROUTER_KEY=
TETHER_TEST_GITHUB_TOKEN=
TETHER_TEST_REPO=
TETHER_GITHUB_CLIENT_ID=

# Release signing
TETHER_KEYSTORE_PATH=
TETHER_KEYSTORE_PASSWORD=
TETHER_KEY_ALIAS=
TETHER_KEY_PASSWORD=
