    <string name="cards_plan_commands">Commands</string>
    <plurals name="cards_plan_commands_count">
        <item quantity="one">%d command</item>
        <item quantity="other">%d commands</item>
    </plurals>
    <string name="cards_plan_questions">Open questions</string>
    <plurals name="cards_plan_questions_count">
        <item quantity="one">%d question</item>
        <item quantity="other">%d questions</item>
    </plurals>
    <string name="cards_plan_edit_label">Plan text</string>
    <string name="cards_plan_save">Save</string>
    <string name="cards_action_cancel">Cancel</string>

    <!-- Failures of the question and plan cards. -->
    <string name="cards_error_not_found">This item is no longer waiting. Refresh the session.</string>
    <string name="cards_error_busy">The session is busy. Try again when the current step ends.</string>
    <string name="cards_error_unavailable">The agent core is not available. Check the provider key in Settings.</string>
    <string name="cards_error_other">That did not go through. Try again.</string>
