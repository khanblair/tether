<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Pinned checklist: one line when collapsed, every item when expanded. -->
    <string name="cards_checklist_progress" tools:ignore="PluralsCandidate">%1$d of %2$d done</string>
    <string name="cards_checklist_all_done">All done</string>
    <string name="cards_checklist_expand">Show checklist</string>
    <string name="cards_checklist_collapse">Hide checklist</string>
    <string name="cards_checklist_dismiss">Dismiss checklist</string>
    <string name="cards_checklist_status_pending">Pending</string>
    <string name="cards_checklist_status_running">In progress</string>
    <string name="cards_checklist_status_done">Done</string>

    <!-- Question card: the agent asks, and the user picks an option or types an answer. -->
    <string name="cards_ask_title">The agent asks</string>
    <string name="cards_ask_hint">Type your answer</string>
    <string name="cards_ask_send">Send</string>
    <string name="cards_ask_answered">Your answer</string>
    <string name="cards_ask_counter" tools:ignore="PluralsCandidate">%1$d of %2$d characters</string>

