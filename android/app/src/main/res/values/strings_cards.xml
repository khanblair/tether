    <string name="cards_plan_title">Plan</string>
    <string name="cards_plan_started">Plan started</string>
    <string name="cards_plan_run">Run this plan</string>
    <string name="cards_plan_edit">Edit plan</string>
    <string name="cards_plan_keep">Keep planning</string>
    <string name="cards_plan_choose_mode">Run the plan in</string>
    <string name="cards_plan_mode_ask">Ask</string>
    <string name="cards_plan_mode_ask_desc">Asks before every edit and every command.</string>
    <string name="cards_plan_mode_accept_edits">Accept edits</string>
    <string name="cards_plan_mode_accept_edits_desc">Edits files without asking. Asks before commands.</string>
    <string name="cards_plan_mode_auto">Auto</string>
    <string name="cards_plan_mode_auto_desc">Runs allowed commands without asking. Asks about anything new.</string>
    <string name="cards_plan_files">Files</string>
    <plurals name="cards_plan_files_count">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
