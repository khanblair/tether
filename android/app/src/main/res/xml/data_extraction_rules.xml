<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: cloud backup and device transfer. Same exclusions as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="linux" />
        <exclude domain="file" path="runtimes" />
        <exclude domain="file" path="workspaces" />
        <exclude domain="file" path="blobs" />
        <exclude domain="file" path="logs" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="linux" />
        <exclude domain="file" path="runtimes" />
        <exclude domain="file" path="workspaces" />
        <exclude domain="file" path="blobs" />
        <exclude domain="file" path="logs" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
