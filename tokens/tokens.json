  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "type": {
    "display": { "font": "sans", "size": 28, "line": 34, "weight": 600, "tracking": -0.2 },
    "title-l": { "font": "sans", "size": 22, "line": 28, "weight": 600, "tracking": -0.1 },
    "title-m": { "font": "sans", "size": 18, "line": 24, "weight": 600, "tracking": 0 },
    "title-s": { "font": "sans", "size": 15, "line": 20, "weight": 600, "tracking": 0 },
    "body-l": { "font": "sans", "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "body": { "font": "sans", "size": 15, "line": 22, "weight": 400, "tracking": 0 },
    "body-s": { "font": "sans", "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "label": { "font": "sans", "size": 14, "line": 20, "weight": 500, "tracking": 0.1 },
    "caption": { "font": "sans", "size": 12, "line": 16, "weight": 400, "tracking": 0.2 },
    "mono": { "font": "mono", "size": 14, "line": 20, "weight": 400, "tracking": 0 },
    "mono-s": { "font": "mono", "size": 12, "line": 18, "weight": 400, "tracking": 0 },
    "mono-label": { "font": "mono", "size": 13, "line": 18, "weight": 500, "tracking": 0 }
  },
  "space": {
    "0": 0, "0_5": 2, "1": 4, "2": 8, "3": 12, "4": 16,
    "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64
  },
  "radius": {
    "none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 20, "full": 999
  },
  "border": {
    "hairline": 1, "input": 1, "input-focus": 2
  },
  "elevation": {
    "1": { "dp": 1, "light": "0 1px 2px rgba(31, 16, 32, 0.06)", "dark": "none" },
    "2": { "dp": 4, "light": "0 4px 16px rgba(31, 16, 32, 0.10)", "dark": "0 4px 16px rgba(0, 0, 0, 0.40)" },
    "3": { "dp": 12, "light": "0 16px 40px rgba(31, 16, 32, 0.18)", "dark": "0 16px 40px rgba(0, 0, 0, 0.55)" }
  },
  "focus": {
    "ring-width": 2, "ring-offset": 2
  },
  "motion": {
    "instant": 0, "fast": 90, "base": 150, "slow": 220, "sheet": 300, "stream-caret": 1000
  },
  "ease": {
    "standard": [0.2, 0, 0, 1],
    "exit": [0.3, 0, 1, 1],
    "emphasized": [0.05, 0.7, 0.1, 1]
  },
  "size": {
    "touch-min": 48, "touch-compact": 36, "icon": 24, "icon-s": 20, "icon-xs": 16, "top-bar": 56,
    "status-line": 28, "composer-min": 56, "approval-bar-min": 72, "tool-card-header": 44,
    "notes-max": 240, "chart-height": 144
  },
  "layout": {
    "transcript-max": 720, "pane-list": 320, "pane-detail-min": 360
  },
  "ratio": {
    "composer-max": 0.4, "sheet-max": 0.9
  },
  "layer": {
    "base": 0, "sticky": 10, "composer": 20, "sheet": 30, "dialog": 40, "snackbar": 50, "overlay": 60
  },
  "breakpoint": {
    "compact": 0, "medium": 600, "expanded": 840, "large": 1200
  },
  "contrast": [
    { "fg": "color.text", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.text-2", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.text-3", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.text-3", "bg": "color.surface-sunken", "min": 4.5 },
    { "fg": "color.text-3", "bg": "color.surface-raised", "min": 4.5 },
    { "fg": "color.on-accent", "bg": "color.accent", "min": 4.5 },
    { "fg": "color.accent-ink", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.accent-ink", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.accent-ink", "bg": "color.accent-soft", "min": 4.5 },
    { "fg": "color.accent-2", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.on-accent-2", "bg": "color.accent-2", "min": 4.5 },
    { "fg": "color.on-tonal", "bg": "color.tonal", "min": 4.5 },
    { "fg": "color.tonal", "bg": "color.text", "min": 4.5, "note": "snackbar action on the inverse surface" },
    { "fg": "color.danger", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.danger", "bg": "color.danger-soft", "min": 4.5 },
    { "fg": "color.success", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.warning", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.warning", "bg": "color.warning-soft", "min": 4.5 },
    { "fg": "color.info", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.line-input", "bg": "color.surface", "min": 3.0 },
    { "fg": "color.accent-ink", "bg": "color.surface", "min": 3.0, "note": "focus ring" },
    { "fg": "color.diff-add-mark", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "color.diff-del-mark", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "color.text", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.keyword", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.string", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.number", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.comment", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.function", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.type", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.variable", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.punctuation", "bg": "color.code-bg", "min": 4.5 },
    { "fg": "syntax.keyword", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.string", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.number", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.comment", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.function", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.type", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.variable", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.punctuation", "bg": "color.diff-add-bg", "min": 4.5 },
    { "fg": "syntax.keyword", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.string", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.number", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.comment", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.function", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.type", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.variable", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "syntax.punctuation", "bg": "color.diff-del-bg", "min": 4.5 },
    { "fg": "chart.series-1", "bg": "color.surface", "min": 3.0 },
    { "fg": "chart.series-2", "bg": "color.surface", "min": 3.0 },
    { "fg": "chart.series-3", "bg": "color.surface", "min": 3.0 },
    { "fg": "chart.series-4", "bg": "color.surface", "min": 3.0 },
    { "fg": "chart.axis-text", "bg": "color.surface", "min": 4.5 }
  ]
}
