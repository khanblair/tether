    "diff-del-mark": { "light": "#B42318", "dark": "#F97066" },
    "diff-word-add": { "light": "#C7E8D1", "dark": "#1D4A33" },
    "diff-word-del": { "light": "#F5CFCA", "dark": "#5A231E" }
  },
  "syntax": {
    "keyword": { "light": "#8A3FA0", "dark": "#D7A5E8" },
    "string": { "light": "#1F6B3A", "dark": "#9AD9AE" },
    "number": { "light": "#9A4A00", "dark": "#F2B47A" },
    "comment": { "light": "#6B5F69", "dark": "#A99BA6" },
    "function": { "light": "#2F5BB8", "dark": "#9CB8F2" },
    "type": { "light": "#7A5200", "dark": "#E9C27A" },
    "variable": { "light": "#1F1020", "dark": "#F4EAF3" },
    "punctuation": { "light": "#4A3A49", "dark": "#CDBCCB" }
